{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "MelaChow Vendor",
    "version":  "0.1.0",
    "identifier":  "org.melachow.vendor",
    "build":  {
                  "frontendDist":  "https://vendors.melachow.com/vendors/dashboard",
                  "devUrl":  "http://localhost:3000/vendors/dashboard",
                  "beforeDevCommand":  "npm run dev"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "MelaChow Vendor",
                                    "width":  1280,
                                    "height":  800,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "minWidth":  960,
                                    "minHeight":  640
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               }
}
